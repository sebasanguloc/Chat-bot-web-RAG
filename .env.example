# Copia este archivo a ".env" y completa tu API key de Groq.
# Obténla gratis en https://console.groq.com -> API Keys -> Create API Key

GROQ_API_KEY=gsk_pega_tu_key_aqui
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.0

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_PATH=./.fastembed_cache

CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=10

PERSIST_DIR=./vector_index
PDF_DIR=./pdfs

MAX_MESSAGE_LENGTH=2000
